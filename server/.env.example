# Copy to server/.env. Supply values for your own test environment.
# Do not commit server/.env or share credentials.
PORT=5000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_KEY
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
EMAIL_USER=YOUR_SENDER@gmail.com
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN
# Set only if your existing student-account workflow uses it:
DEFAULT_STUDENT_PASSWORD=
